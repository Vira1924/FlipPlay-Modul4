{
	"info": {
		"_postman_id": "f4b8e2c1-9a1d-4d62-a1a7-flipplay-mod4",
		"name": "FlipPlay REST API - Modul 4",
		"description": "Koleksi endpoint FlipPlay REST API (Laravel 12) sesuai Modul 4 Pemrograman Web.",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"variable": [
		{
			"key": "base_url",
			"value": "http://127.0.0.1:8000/api"
		}
	],
	"item": [
		{
			"name": "1. Media - Get All",
			"request": {
				"method": "GET",
				"url": "{{base_url}}/media"
			}
		},
		{
			"name": "2. Media - Filter by Title",
			"request": {
				"method": "GET",
				"url": "{{base_url}}/media?title=Jujutsu"
			}
		},
		{
			"name": "3. Media - Show Detail (with Users)",
			"request": {
				"method": "GET",
				"url": "{{base_url}}/media/1"
			}
		},
		{
			"name": "4. Media - Create (Happy Path - 201)",
			"request": {
				"method": "POST",
				"header": [
					{ "key": "Accept", "value": "application/json" },
					{ "key": "Content-Type", "value": "application/json" }
				],
				"body": {
					"mode": "raw",
					"raw": "{\n    \"title\": \"Attack on Titan\",\n    \"type\": \"Anime\",\n    \"genre\": \"Action, Dark Fantasy\",\n    \"description\": \"Pertarungan umat manusia melawan Titan.\",\n    \"episodes\": 89\n}"
				},
				"url": "{{base_url}}/media"
			}
		},
		{
			"name": "5. Media - Create Empty Title (Failure Path - 422)",
			"request": {
				"method": "POST",
				"header": [
					{ "key": "Accept", "value": "application/json" },
					{ "key": "Content-Type", "value": "application/json" }
				],
				"body": {
					"mode": "raw",
					"raw": "{\n    \"title\": \"\",\n    \"type\": \"Anime\"\n}"
				},
				"url": "{{base_url}}/media"
			}
		},
		{
			"name": "6. Media - Update Partial (PATCH - 200)",
			"request": {
				"method": "PATCH",
				"header": [
					{ "key": "Accept", "value": "application/json" },
					{ "key": "Content-Type", "value": "application/json" }
				],
				"body": {
					"mode": "raw",
					"raw": "{\n    \"episodes\": 25\n}"
				},
				"url": "{{base_url}}/media/1"
			}
		},
		{
			"name": "7. Media - Delete (200)",
			"request": {
				"method": "DELETE",
				"header": [
					{ "key": "Accept", "value": "application/json" }
				],
				"url": "{{base_url}}/media/4"
			}
		},
		{
			"name": "8. Users - Get All",
			"request": {
				"method": "GET",
				"url": "{{base_url}}/users"
			}
		},
		{
			"name": "9. Collection - Get User Collection",
			"request": {
				"method": "GET",
				"url": "{{base_url}}/users/1/collection"
			}
		},
		{
			"name": "10. Collection - Add Media (Happy Path - 201)",
			"request": {
				"method": "POST",
				"header": [
					{ "key": "Accept", "value": "application/json" },
					{ "key": "Content-Type", "value": "application/json" }
				],
				"body": {
					"mode": "raw",
					"raw": "{\n    \"media_id\": 2\n}"
				},
				"url": "{{base_url}}/users/1/collection"
			}
		},
		{
			"name": "11. Collection - Add Duplicate Media (Failure Path - 409)",
			"request": {
				"method": "POST",
				"header": [
					{ "key": "Accept", "value": "application/json" },
					{ "key": "Content-Type", "value": "application/json" }
				],
				"body": {
					"mode": "raw",
					"raw": "{\n    \"media_id\": 1\n}"
				},
				"url": "{{base_url}}/users/1/collection"
			}
		},
		{
			"name": "12. Collection - Remove Media (200)",
			"request": {
				"method": "DELETE",
				"header": [
					{ "key": "Accept", "value": "application/json" }
				],
				"url": "{{base_url}}/users/1/collection/1"
			}
		}
	]
}
